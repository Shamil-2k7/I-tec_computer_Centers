# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/akm_lms?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_for_refresh_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password Reset
RESET_TOKEN_EXPIRES_MIN=30

# Device Login Restriction
MAX_DEVICES_PER_STUDENT=2

# Email (Nodemailer - e.g. Gmail SMTP or Mailtrap for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
FROM_EMAIL=noreply@akmlms.com
FROM_NAME=AKM LMS

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200

# Admin Seed
ADMIN_EMAIL=admin@akmlms.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin
